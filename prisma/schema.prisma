datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        Int      @id @default(autoincrement())
  uid       String   @unique
  name      String
  email     String   @unique
  role      String
  level     String?
  avatar    String?
  createdAt DateTime @default(now())

  completedSigns Json?
lastSeen       DateTime?
}
